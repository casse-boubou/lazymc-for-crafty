{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "timezone": "Europe/Paris",
  "rebaseWhen": "auto",
  "dependencyDashboardLabels": ["dependencies"],
  // "extends": [
  //   "github>casse-boubou/ha-addon-workflows//.github/renovate.json"
  // ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG ALPINE_BASE_IMAGE_VERSION=(?<currentValue>[0-9]+\\.[0-9]+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "timvisee/lazymc",
      "matchStrings": [
        "ARG LAZYMC_VERSION=\"(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "datasourceTemplate": "repology",
      "depNameTemplate": "alpine_3_24/{{package}}",
      "matchStringsStrategy": "any",
      "matchStrings": [
        "\\s\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s+"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "docker {{depNameTemplate}} Image"
    },
    {
      "matchDatasources": ["github-releases"],
      "matchDepNames": ["timvisee/lazymc"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "LazyMC"
    },
    {
      "matchDatasources": ["repology"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "{{packageName}}",
      "groupName": "internal packages"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "⬆️ MAJOR",
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "{{depName}}",
      "groupName": "minor and patch",
      "automerge": true
    }
  ]
}
