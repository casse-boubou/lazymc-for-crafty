{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Europe/Paris",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "prCreation": "not-pending",
  "rebaseWhen": "auto",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "timvisee/lazymc",
      "depNameTemplate": "LazyMC",
      "matchStrings": [
        "(ARG)\\s(LAZYMC.*_VERSION)=\"(?<currentValue>v?[0-9]+\\.[0-9]+(\\.[0-9]+){0,1})\"\\n"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/{{package}}",
      "depNameTemplate": "{{package}}",
      "matchStrings": [
        "\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["regex"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["LazyMC"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "⬆️ MAJOR",
      "commitMessageTopic": "github-actions {{packageName}}",
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "github-actions {{packageName}}",
      "commitMessageSuffix": "{{packageName}}",
      "groupName": "github-actions minor and/or patch",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "docker {{packageName}} image"
    },
    {
      "matchManagers": ["regex"],
      "matchDatasources": ["repology"],
      "commitMessagePrefix": "⬆️",
      "commitMessageTopic": "{{depName}}",
      "groupName": "internal packages"
    }
  ]
}
