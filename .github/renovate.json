{
  "extends": ["github>casse-boubou/.github//.github/renovate.json"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "timvisee/lazymc",
      "depNameTemplate": "LazyMC",
      "matchStrings": [
        "(ARG)\\s(lazymc.*_VERSION)=\"(?<currentValue>v?[0-9]+\\.[0-9]+(\\.[0-9]+){0,1})\"\\n{0,1}"
      ],
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/"],
      "datasourceTemplate": "repology",
      "packageNameTemplate": "alpine_3_24/{{package}}",
      "depNameTemplate": "{{package}}",
      "matchStrings": [
        "\\s(?<package>[a-z0-9][a-z0-9-_]+)=(?<currentValue>[a-z0-9-_.]+)\\s{0,1}"
      ],
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom"],
      "matchDatasources": ["github-tags"],
      "matchDepNames": ["LazyMC"],
      "commitMessagePrefix": "✨",
      "commitMessageTopic": "{{depName}}"
    }
  ]
}
